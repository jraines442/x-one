{
  "name": "x-one",
  "version": "0.1.0",
  "description": "Build modern web projects with zero config",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "x-one": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "npm run build && node --test test/smoke.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cli",
    "typescript",
    "react",
    "next.js",
    "vite",
    "zero-config",
    "spa",
    "scaffolding"
  ],
  "author": "Jay Raines <james.h.raines@outlook.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "enquirer": "^2.4.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/fs-extra": "^11.0.4",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jraines442/X-one.git"
  },
  "homepage": "https://github.com/jraines442/X-one#readme",
  "bugs": {
    "url": "https://github.com/jraines442/X-one/issues"
  }
}
